#!/bin/sh
# Blocks personal data, private paths and secrets from being committed.
# Enable with: git config core.hooksPath .githooks
set -eu
cd "$(git rev-parse --show-toplevel)"

node scripts/check-denylist.mjs --staged

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed; refusing to commit." >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner
